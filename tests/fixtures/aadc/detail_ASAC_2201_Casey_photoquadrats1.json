GICAL DYNAMICS","variable_level_1":"COMMUNITY DYNAMICS","variable_level_2":"SPECIES DOMINANCE INDICES"},{"category":"EARTH SCIENCE","topic":"BIOSPHERE","term":"ECOLOGICAL DYNAMICS","variable_level_1":"COMMUNITY DYNAMICS","variable_level_2":"COMMUNITY STRUCTURE"}],"iso_topic_category":["BIOTA","ENVIRONMENT","OCEANS","TRANSPORTATION"],"keyword":["ASSEMBLAGE","ASCIDIANS","BENTHIC","BIVALVES","COMMUNITY","CONTAMINATION","FIELD EXPERIMENT","HUMAN IMPACT","MACROBENTHOS","POLLUTION","RECOLONISATION","SPONGES","RECRUITMENT","TUBE WORMS"],"sensor_name":{"short_name":"Cameras"},"source_name":{"short_name":"FIELD SURVEYS"},"temporal_coverage":{"start_date":"1997-10-18","stop_date":"1997-12-11"},"data_set_progress":"IN WORK","spatial_coverage":{"southernmost_latitude":"-66.2941","northernmost_latitude":"-66.27913","westernmost_longitude":"110.52252","easternmost_longitude":"110.54701","minimum_depth":"5 Metres","maximum_depth":"25 Metres"},"location":[{"location_category":"OCEAN","location_type":"SOUTHERN OCEAN"},{"location_category":"CONTINENT","location_type":"ANTARCTICA","detailed_location":"East Antarctica"},{"location_category":"CONTINENT","location_type":"ANTARCTICA","detailed_location":"Casey Station"},{"location_category":"CONTINENT","location_type":"ANTARCTICA","detailed_location":"Brown Bay"},{"location_category":"CONTINENT","location_type":"ANTARCTICA","detailed_location":"O'Brien Bay"},{"location_category":"CONTINENT","location_type":"ANTARCTICA","detailed_location":"Shannon Bay"},{"location_category":"GEOGRAPHIC REGION","location_type":"POLAR"}],"data_resolution":{"vertical_resolution":"1 Metre(s)"},"access_constraints":"These data are not yet publicly available.","use_constraints":"This data set conforms to the CCBY Attribution License (http://creativecommons.org/licenses/by/4.0/).\n\nPlease follow instructions listed in the citation reference provided at http://data.aad.gov.au/aadc/metadata/citation.cfm?entry_id=ASAC_2201_Casey_photoquadrats1 when using these data.","data_set_language":"English","originating_center":"Australian Antarctic Division","data_center":{"data_center_name":{"short_name":"AU/AADC","long_name":"Australian Antarctic Data Centre, Australia"},"data_center_url":"http://data.aad.gov.au","personnel":{"role":"DATA CENTER CONTACT","first_name":"DATA OFFICER","last_name":"AADC","email":"metadata@aad.gov.au","phone":"+61 3 6232 3244","fax":"+61 3 6232 3351","contact_address":{"address":["Australian Antarctic Division","203 Channel Highway"],"city":"Kingston","province_or_state":"Tasmania","postal_code":"7050","country":"Australia"}}},"summary":{"abstract":"A survey of the epibenthic fauna of hard-substrata was made around Casey Station, using a camera mounted on a frame to take photoquadrats. A nested sampling design was used with several spatial scales. At each location there were two sites, approximately 50-100 m apart. At each site there were three by 15 m long transects, approximately 5 m apart. On each transect there were 2 plots, 5 m long by 2 m wide. Six photoquadrats were taken in each plot. This metadata record describes one component of this survey, photoquadrats taken in flat or gently sloping rocky areas, where the bottom consisted of flat bedrock, gravel or cobbles. A separate survey was done in and around boulders and boulder fields. One of the aims of this survey was to determine if there is any evidence of human impacts in these assemblages. There were several control and several potentially impacted locations.\n\nThe data have yet to be analysed.\n\nAlso links to ASAC 1100."},"related_url":[{"url_content_type":{"type":"PROJECT HOME PAGE"},"url":"https://projects.aad.gov.au/search_projects_results.cfm?project_no=2201","description":"Public information for ASAC project 2201"},{"url_content_type":{"type":"VIEW RELATED INFORMATION"},"url":"http://data.aad.gov.au/aadc/metadata/citation.cfm?entry_id=ASAC_2201_Casey_photoquadrats1","description":"Citation reference for this metadata record and dataset"}],"idn_node":[{"short_name":"AMD/AU"},{"short_name":"CEOS"},{"short_name":"AMD"}],"originating_metadata_node":"AADC","metadata_name":"CEOS IDN DIF","metadata_version":"VERSION 9.9.3","dif_creation_date":"2001-05-02","last_dif_revision_date":"2019-04-04","dif_revision_history":"2015-09-18 - record updated by Dave Connell.  Basic updates.\n2019-04-04 - record updated by Dave Connell for ISO compliance.","extended_metadata":{"metadata":[{"group":"gov.nasa.gsfc.gcmd","name":"metadata.uuid","value":"ce5baa1b-a820-4f17-bf7e-aab22d79b6b9"},{"group":"gov.nasa.gsfc.gcmd","name":"metadata.extraction_date","value":"2019-04-04 10:15:27"},{"group":"gov.nasa.gsfc.gcmd","name":"metadata.keyword_version","value":"8.6"}]},"citation":"Riddle, M.J. and Stark, J.S. (2001) Photoquadrat survey of hard substratum assemblages around Casey Station: flat and sloping rocky areas., Ver. 1,  <em>Australian Antarctic Data Centre</em> - <a href=\"https://data.aad.gov.au/metadata/ASAC_2201_Casey_photoquadrats1\">https://data.aad.gov.au/metadata/ASAC_2201_Casey_photoquadrats1</a>, Accessed: 2026-10-08"}}